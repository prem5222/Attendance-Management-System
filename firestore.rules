rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Check if user is the document owner
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    
    // Helper: Check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Users collection
    match /users/{uid} {
      allow read: if isAuthenticated() && (isOwner(uid) || isAdmin());
      allow create: if isAuthenticated() && isOwner(uid);
      allow update: if isAuthenticated() && (isOwner(uid) || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Attendance collection
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && 
        (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
        request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && 
        (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Face Descriptors collection
    match /faceDescriptors/{uid} {
      allow read, write: if isAuthenticated() && isOwner(uid);
    }
    
    // Settings collection
    match /settings/{document} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
